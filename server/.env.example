# Copy to server/.env and fill in values. Never commit the real .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (replica set required for transactions)
MONGODB_URI=

# Long random string, at least 32 characters
JWT_SECRET=

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# groq | mock  (mock runs the assistant without an API key)
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
