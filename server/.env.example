# Copy to server/.env and fill in values. Never commit the real .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (replica set required for transactions)
MONGODB_URI=

# Long random string, at least 32 characters
JWT_SECRET=
# Staff session length, e.g. 12h or 7d
JWT_EXPIRES_IN=12h

# Frontends allowed to call the API from a browser (CORS allowlist), comma-separated,
# scheme://host[:port] with no path. Any other origin gets 403.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Shared secret lead sources send as the X-Ingest-Key header (at least 24 characters).
# Leave empty to allow only signed-in staff to add leads.
INGEST_API_KEY=

# Password for every demo staff account created by `npm run seed` (default Demo@12345)
SEED_PASSWORD=

# Run the reminder and message-dispatch job inside the API process (true | false)
JOBS_ENABLED=true

# groq | mock  (mock runs the assistant without an API key)
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
